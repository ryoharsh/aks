EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional legacy fallback when a publishable key is not configured.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Defaults to https://your-project.supabase.co/functions/v1/auth-callback
EXPO_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=https://your-project.supabase.co/functions/v1/auth-callback
EXPO_PUBLIC_AUTH_FACEBOOK_ENABLED=false

# Optional Android build toggle.
# EXPO_USE_COMMUNITY_AUTOLINKING=1

# RevenueCat (https://app.revenuecat.com) — used to read and manage subscriptions.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-ios-api-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-android-api-key
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=your-web-api-key

# Server-side secret shared with the RevenueCat webhook (set in Supabase). Not read by the app.
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# Server-side OpenAI-compatible provider (set as Supabase secrets, not app config).
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=your-model-name

# Realtime voice conversations (set in Supabase, not read by the app).
AI_REALTIME_PROVIDER=openai
AI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
OPENAI_API_KEY=your-openai-api-key

# NOTE: live voice requires a native development build of Aks (Expo Go is not
# enough) so the app can stream PCM audio to the realtime session.


ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=