# Aks example env. Copy to .env and fill your values.
# EXPO PUBLIC lines ship in the app build.
# Other lines are server secrets. Set them with supabase secrets set.

# App Supabase connection
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=
EXPO_PUBLIC_AUTH_FACEBOOK_ENABLED=false

# Mirror voice input. Default live speech-to-text into the composer draft.
# Set to true only to permit the legacy audio-recording → transcription
# fallback pipeline. Default (missing/false): no recording.
EXPO_PUBLIC_ENABLE_MIRROR_VOICE_RECORDING=false

# Full-screen AI conversation. Disabled unless explicitly enabled:
# EXPO_PUBLIC_ENABLE_AI_CONVERSATION=true
# registers the AiConversation route and its entry points. Requires a
# rebuild / dev server restart to take effect (EXPO_PUBLIC vars are
# inlined at bundle time).

# App push notifications
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# App billing. One key per platform from app.revenuecat.com.
# Each platform requires its own key. Test keys work in debug builds only.
# Release builds need the production key for that platform.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your-ios-api-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your-android-api-key
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=your-web-api-key

# Billing kill-switch (single variable for app + server). Default enabled:
# anything but the exact string "false" keeps the Subscription gate closed.
# Set to "false" to run the app without limitations (no paywall, RevenueCat
# never contacted, Edge Function checks pass). Requires an app rebuild to
# take effect on the client, and `supabase secrets set
# EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=false` + Edge Function redeploy on the
# server.
# EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=false

# Server shared secrets
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# Server AI chat
AI_LLM_PROVIDER=openai-compatible
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=your-ai-api-key
AI_LLM_MODEL=your-model-name

# Server voice transcription
# AI_STT_PROVIDER=whisper
# AI_STT_MODEL=whisper-1

# Server voice provider. Pick openai gemini or sarvam. Default openai.
# AI_VOICE_PROVIDER=openai
#
# openai needs OPENAI_API_KEY and AI_REALTIME_MODEL
# OPENAI_API_KEY=your-openai-api-key
# AI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
#
# gemini needs GEMINI_API_KEY and AI_GEMINI_LIVE_MODEL
# GEMINI_API_KEY=your-gemini-api-key
# AI_GEMINI_LIVE_MODEL=models/gemini-3.8-live
#
# sarvam needs SARVAM_API_KEY AI_STT_MODEL AI_TTS_MODEL and the AI chat models above
# SARVAM_API_KEY=your-sarvam-api-key
# AI_STT_MODEL=saarika:v2.5
# AI_TTS_MODEL=bulbul:v2
#
# OpenAI session voice. Default alloy.
# AI_TTS_PROVIDER=openai
# AI_TTS_MODEL=alloy

# Server connected sources. Only the ones you connect.
SOURCE_OAUTH_STATE_SECRET=your-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TODOIST_CLIENT_ID=
# TODOIST_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Server push sender. The app id is the same value as the app build above.
ONESIGNAL_REST_API_KEY=your-onesignal-rest-key

# Server development only. These user ids skip Premium checks.
AKS_DEV_BYPASS_USER_IDS=paste-your-uid-here

# Live voice needs a native development build. Expo Go is not enough.
