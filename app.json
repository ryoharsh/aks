{
  "expo": {
    "name": "aks",
    "slug": "aks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#010100"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/satoshi_light.otf",
            "./assets/fonts/satoshi_regular.otf",
            "./assets/fonts/satoshi_medium.otf",
            "./assets/fonts/satoshi_bold.otf",
            "./assets/fonts/satoshi_black.otf"
          ]
        }
      ],
      "expo-splash-screen",
      "expo-video",
      ["expo-audio", {"microphonePermission": "Allow Aks to record what you want to reflect on.", "recordAudioAndroid": true, "enableBackgroundRecording": false}]
    ]
  }
}
